ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-with-openssl-rand-hex-32

# --- Firebase (content + image storage) ---
# When these are set, admin content is stored in Firestore and image uploads in
# Firebase Storage (required on Vercel). Leave them blank for local dev to use
# the filesystem instead. Get them from the service-account JSON in the Firebase
# console (Project settings -> Service accounts -> Generate new private key).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the whole private key on one line, keeping the literal \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Usually <project-id>.appspot.com (older projects) or <project-id>.firebasestorage.app (newer).
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Cloudflare Turnstile (bot protection on the contact & quote forms) ---
# Leave both blank to disable (forms still work, just without the challenge).
# Create a widget at Cloudflare dashboard -> Turnstile. The site key is public;
# the secret key must stay private.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Enquiry email notifications (optional) ---
# Set EMAIL_NOTIFICATIONS=on and fill in real SMTP details to email the
# business whenever a contact/quote form is submitted. Left off = no emails.
EMAIL_NOTIFICATIONS=off
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your-smtp-password
# Address the notification is sent FROM (must be allowed by your SMTP provider)
ENQUIRY_FROM=Ecoshine Website <notifications@example.com>
# Address that receives the enquiry notifications
ENQUIRY_TO=info@example.com
